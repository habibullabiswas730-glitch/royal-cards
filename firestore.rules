rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if me(uid);
      allow delete: if me(uid);

      match /friends/{friendUid} {
        allow read, write: if me(uid);
      }
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow delete: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /invites/{inviteId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow delete: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /rooms/{roomId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids;
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /players/{playerUid} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
        allow create, update: if me(playerUid) &&
          request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
        allow delete: if me(playerUid);
      }
    }

    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if me(uid);
    }
  }
}
